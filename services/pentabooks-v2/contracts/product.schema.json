{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crownthrive.com/schemas/pentabooks/product-v2.json",
  "title": "PentaBooks Product v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "product_id",
    "title",
    "version",
    "category",
    "credits",
    "commerce_state",
    "customer_package_sha256"
  ],
  "properties": {
    "product_id": {
      "type": "string",
      "pattern": "^VM-PB-R[0-9]{2}-[0-9]{3}$"
    },
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "kind": {
      "enum": ["book", "companion", "guide", "workbook", "journal", "cards", "kit", "other"]
    },
    "credits": { "type": "number", "minimum": 0 },
    "commerce_state": {
      "enum": ["SAFE_HOLD", "COMMERCIAL_CANDIDATE", "RELEASE_READY", "PUBLISHED"]
    },
    "customer_package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "hard_holds": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}