{
  "schema": "ct.chlom.api-registry.v1",
  "version": "1.1.0",
  "state": "PRODUCTION_CONTROL_PLANE_OPERATIONAL_DATA_PLANE_CONFIGURATION_HOLD",
  "runtime": {
    "provider": "vercel",
    "project": "chlom-protocol",
    "production_url": "https://chlom-protocol.vercel.app",
    "node": "24.x",
    "framework": "vercel_functions_plus_static_control_surface",
    "output_directory": "public"
  },
  "authority": {
    "default": "read_only",
    "arbitrary_rpc_endpoints": false,
    "arbitrary_sql": false,
    "private_key_custody": false,
    "chain_broadcast": {
      "default": false,
      "mcp_exposed": false,
      "requires": [
        "CHLOM_CHAIN_WRITE_ENABLED=true",
        "CHLOM_GOVERNANCE_STATE=promoted",
        "exact x-chlom-ecac-digest"
      ]
    }
  },
  "rest": [
    {
      "method": "GET",
      "path": "/api/health",
      "auth": "public",
      "risk": "D0"
    },
    {
      "method": "POST",
      "path": "/api/v1/rpc",
      "implementation_path": "/api/rpc",
      "auth": "bearer",
      "risk": "D1_D2"
    },
    {
      "method": "POST",
      "path": "/api/v1/analytics",
      "implementation_path": "/api/analytics",
      "auth": "bearer",
      "risk": "D1"
    },
    {
      "method": "POST",
      "path": "/api/v1/attest",
      "implementation_path": "/api/attest",
      "auth": "bearer",
      "risk": "D1"
    }
  ],
  "mcp": {
    "path": "/api/mcp",
    "transport": "streamable_http_stateless",
    "latest_spec": "2026-07-28",
    "legacy_fallback": "2025-11-25",
    "auth": "bearer",
    "origin_validation": true,
    "required_modern_headers": [
      "MCP-Protocol-Version",
      "Mcp-Method",
      "Mcp-Name for tools/call"
    ],
    "tools": [
      "chlom_provider_status",
      "chlom_chain_read",
      "chlom_verify_transaction",
      "chlom_query_blockchain_analytics",
      "chlom_prepare_evidence_anchor"
    ]
  },
  "providers": {
    "rpc_priority": [
      "quicknode",
      "custom",
      "google-blockchain-rpc-deprecated",
      "alchemy",
      "infura"
    ],
    "google_blockchain_rpc_sunset": "2026-12-15",
    "durable_google_lane": "bigquery_blockchain_analytics",
    "google_authentication": "vercel_oidc_workload_identity_federation"
  },
  "evidence": {
    "schema": "ct.chlom.chain-evidence.v1",
    "dail_projection": true,
    "database_persistence_claimed": false,
    "anchor_broadcast_claimed": false
  }
}
